{
  "version": 2,
  "functions": {
    "api/ops-jobs.js": {
      "maxDuration": 60,
      "includeFiles": "{api/fonts/**,node_modules/sharp/**,node_modules/@img/**}"
    }
  },
  "routes": [
    {
      "src": "/(index|portal_core)\\.html",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(self), microphone=(self), geolocation=()"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
