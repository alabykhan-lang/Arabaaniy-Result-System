{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://first-choice-result-portal.vercel.app/ops-contract/v1/staged-rows.schema.json",
  "title": "Ops staged rows v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rows"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "rows": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "row_no": { "type": "integer", "minimum": 1 },
          "admno": { "type": "string", "maxLength": 300 },
          "candidate_admno": { "type": "string", "maxLength": 300 },
          "name_raw": { "type": "string", "maxLength": 300 },
          "flag": { "type": "string", "maxLength": 300 },
          "subject_key": { "type": "string", "pattern": "^[a-z0-9._-]+:[a-z0-9._-]+$" },
          "subject_label": { "type": "string" },
          "component": { "enum": ["ca1", "ca2", "ca3", "exam"] },
          "value": { "type": "number", "minimum": 0, "maximum": 100 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": { "type": "string" }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
